# Discord bot token — Developer Portal > your application > Bot > Reset Token
# (클라이언트 시크릿이나 OAuth 토큰이 아니라 "봇 토큰"이다)
DISCORD_BOT_TOKEN=

# 선택: 서버가 하나로 고정된 배포에서 guild_id 인자를 생략할 수 있게 한다
DISCORD_GUILD_ID=

# 선택: 없으면 캐시 없이 동작한다 (pip install "discord-mcp[redis]" 필요)
REDIS_URL=redis://localhost:6379

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
